# OmniVerify — Environment Configuration Example
# Copy this file to .env and configure your database credentials.
# NEVER commit .env to source control.

# Neon PostgreSQL Database Connection String (Lakebase Postgres)
# Obtain this from your Neon Console (https://console.neon.tech)
# Recommended: Use the connection-pooled endpoint (-pooler) for FastAPI web requests
# Format: postgresql://[user]:[password]@[endpoint]-pooler.[region].aws.neon.tech/[dbname]?sslmode=require
DATABASE_URL=
